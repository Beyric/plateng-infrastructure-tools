# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
# terraform.tfvars IS tracked (Finding 24): it holds sizing, not secrets. ADR-010
# guarantees the database password never enters it. A gitignored tfvars silently
# overrides git-tracked defaults on whichever machine it lives on, which is how
# main stopped describing reality in Phase 6. Anything sensitive goes in a
# *.secret.tfvars, which stays ignored.
*.secret.tfvars
*.secret.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl.bak

# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
kubeconfig
*.kubeconfig
vault-recovery-keys*
*-credentials.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Provider lock files belong to root modules only
modules/**/.terraform.lock.hcl

# Subagent working notes — task briefs, reports and the run ledger
.superpowers/

# Terraform plan files - binary, churn every plan, and can carry sensitive values
tfplan
*.tfplan
