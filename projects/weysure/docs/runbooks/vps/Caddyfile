# TLS and routing for the single-VPS layout. Caddy gets and renews Let's Encrypt certificates by itself:
# DNS for WEB_DOMAIN, www.WEB_DOMAIN and API_DOMAIN must point at this server (DNS only / grey cloud) and
# ports 80 and 443 must be open before the first start. Companion to ../VPS_MIGRATION.md.
{
	email {$ACME_EMAIL}
}

# The web app.
{$WEB_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# The API (also WebSockets: reverse_proxy upgrades them by itself).
{$API_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy api:8000 {
		# The API takes the client's address from CF-Connecting-IP, but only from a trusted peer
		# (TRUSTED_PROXY_CIDRS = this Caddy). Cloudflare is NOT in front in this layout, so Caddy
		# overwrites whatever the caller sent with the real socket address: a client cannot pick its
		# own rate-limit bucket or audit IP. If you later put Cloudflare's proxy (orange cloud) in
		# front, DELETE this line and firewall ports 80/443 to Cloudflare's ranges (runbook, "Later").
		header_up CF-Connecting-IP {remote_host}
		# The app never reads X-Forwarded-For; do not let callers send one through.
		header_up -X-Forwarded-For
	}
}
