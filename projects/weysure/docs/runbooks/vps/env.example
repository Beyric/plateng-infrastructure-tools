# /opt/weysure/.env on the VPS. PLACEHOLDERS ONLY: this file is names + example shapes, never real values.
# Build the real one from (a) the non-secret settings in plateng-gitops
# projects/weysure/environments/prod/apps/api/values.yaml (commonEnv) and (b) the secrets in Vault
# secret/weysure/prod, as VPS_MIGRATION.md step 5 describes. `chmod 600 .env`; it never goes into git.
# Authority for every name and default: Weysure-API/app/core/config.py and Weysure-API/.env.example.
# [SECRET] = a secret. Anything else is a plain setting.

# --- Used by docker-compose.yaml and Caddy (not by the API) --------------------------------------------
WEB_DOMAIN=weysure.com
API_DOMAIN=api.weysure.com
ACME_EMAIL=you@example.com
# Image tags: the ones live in prod are in plateng-gitops projects/weysure/environments/prod/images.yaml
API_IMAGE=weysure-api:CHANGE-ME-tag
WEB_IMAGE=weysure-web:CHANGE-ME-tag
POSTGRES_USER=weysure
POSTGRES_DB=weysure
# [SECRET] letters and digits only (it is placed inside a URL). Generate: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
POSTGRES_PASSWORD=CHANGE-ME

# --- API + worker: required to start (the app refuses to boot without them) ----------------------------
# [SECRET] >= 32 characters, not a placeholder. KEEP THE PRODUCTION VALUE: it signs every session token and,
# if you change it, everyone is signed out (acceptable, but plan for it). openssl rand -hex 32
SECRET_KEY=CHANGE-ME
# "prelaunch" today (test provider keys). "production" refuses to boot with sandbox Dojah or non-live Paystack keys.
ENVIRONMENT=prelaunch
SERVER_HOST=https://api.weysure.com
FRONTEND_URL=https://weysure.com
BACKEND_CORS_ORIGINS=["https://weysure.com"]
REFRESH_COOKIE_SECURE=true
EMAILS_FROM_EMAIL=support@weysure.com
EMAILS_FROM_NAME=Weysure
ADMIN_NOTIFICATION_EMAILS=admin@example.com
# DATABASE_URL and REDIS_URL are set by docker-compose.yaml itself. Do not add them here.

# --- Email (Resend SMTP, implicit TLS, port 465 only) --------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# [SECRET]
SMTP_PASSWORD=CHANGE-ME

# --- Paystack [SECRET: the three secrets] ----------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

# --- Cloudinary: uploaded documents live THERE, not in the database or on the server ---------------------
CLOUDINARY_CLOUD_NAME=
# [SECRET]
CLOUDINARY_API_KEY=
# [SECRET]
CLOUDINARY_API_SECRET=

# --- SMS (Termii) ---------------------------------------------------------------------------------------
# [SECRET] required outside development
TERMII_API_KEY=
TERMII_BASE_URL=copy-from-gitops-values
TERMII_SENDER_ID=N-Alert
TERMII_OTP_CHANNEL=dnd
TERMII_OTP_TEMPLATE=copy-from-gitops-values
OTP_EXPIRE_MINUTES=10

# --- Identity checks (Dojah) ----------------------------------------------------------------------------
DOJAH_ENVIRONMENT=sandbox
DOJAH_BASE_URL=copy-from-gitops-values
DOJAH_APP_ID=copy-from-gitops-values
DOJAH_PUBLIC_KEY=copy-from-gitops-values
DOJAH_BVN_WIDGET_ID=copy-from-gitops-values
DOJAH_NIN_WIDGET_ID=copy-from-gitops-values
DOJAH_FACE_MATCH_THRESHOLD=70
# [SECRET]
DOJAH_API_KEY=
# [SECRET]
DOJAH_WEBHOOK_SECRET=
# [SECRET] 32+ random bytes (hex). Keep the production value: BVN/NIN fingerprints in the database are HMACs under it.
KYC_FINGERPRINT_KEY=
CAC_PROVIDER=dojah
DOJAH_SANDBOX_CAC_IN_PRELAUNCH=true

# --- Security keys the production data depends on [SECRET: keep the production values] -------------------
# [SECRET] HMAC key for stored device/IP hashes (>= 32 bytes). A new one breaks device/IP matching for up to 90 days.
RISK_SIGNAL_HASH_KEY=
# [SECRET] Fernet key that encrypts second-factor secrets. A new one makes every enrolled authenticator unreadable.
MFA_ENCRYPTION_KEY=
# [SECRET]
MFA_CODE_PEPPER=
MFA_ENABLED=true
MFA_STEP_UP_ENFORCED=shadow
# Must equal the site's registrable domain: passkeys are bound to it. A different domain invalidates every passkey.
WEBAUTHN_RP_ID=weysure.com
WEBAUTHN_ORIGINS=["https://weysure.com"]

# --- Feature switches live in prod on 2026-11-20 (re-check gitops values.yaml, it is the authority) ----------
ORIGIN_RULES_ENFORCED=true
RISK_HOLDS_MODE=enforce
RISK_SIGNALS_CAPTURE_ENABLED=false
LIVE_AUTO_PAUSE_MODE=enforce
DVA_CREATE_ENABLED=true
DVA_CARD_CAP_ENABLED=true
REFUND_TO_SOURCE_ENABLED=true
DVA_REFUND_ENABLED=true
KYC_ENHANCED_ENABLED=true
KYB_APPLICATIONS_ENABLED=true
WS_ALLOW_URL_TOKEN=false
